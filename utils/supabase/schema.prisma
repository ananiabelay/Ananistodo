datasource db {
  provider = "postgresql"
  // Look, no 'url' line here anymore! Prisma 7 handles it in the config file.
}

generator client {
  provider = "prisma-client-js"
}

model Todo {
  id        String   @id @default(cuid())
  userId    String   
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}